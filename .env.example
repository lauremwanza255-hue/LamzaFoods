# Public URL of the site, used for canonical links, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.lamzafoods.com

# Search indexing. Leave "false" on staging/preview so search engines stay out.
# Set to "true" only on the approved production deployment.
SITE_INDEXING=false

# Hide content that is still marked unverified in data/site.ts and data/products.ts
# (statistics, phone number, operational claims). Set to "true" for a cautious launch.
NEXT_PUBLIC_HIDE_UNVERIFIED=false

# ---- Inquiry handling ---------------------------------------------------------
# At least one delivery channel must be configured, otherwise the forms report
# honestly that the inquiry service is not connected (nothing is faked).

# Supabase (PostgreSQL) storage. Create the table with docs/supabase-schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email.
RESEND_API_KEY=
CONTACT_EMAIL=
FROM_EMAIL=

# Local development only: store inquiries in .data/inquiries.jsonl.
# Never enable on a serverless/production host.
INQUIRY_DEV_FILE_STORE=false
